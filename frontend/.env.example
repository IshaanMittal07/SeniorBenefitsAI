# Frontend Environment Variables
# Copy this file to .env and adjust as needed.

# Port for the React dev server (the backend uses 3000)
PORT=3001

# Base URL of the backend API
REACT_APP_API_URL=http://localhost:3000

REACT_APP_AWS_REGION=us-east-1
REACT_APP_COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
REACT_APP_COGNITO_CLIENT_ID=your-cognito-client-id
REACT_APP_COGNITO_REDIRECT_URI=http://localhost:3001
REACT_APP_COGNITO_LOGOUT_URI=http://localhost:3001/login
